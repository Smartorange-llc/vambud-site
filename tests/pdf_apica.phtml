$by_compass = $by_img($by_assets.'/compass.png', 26.21, 24.55);

// SVG-блоки: $svg_box — рамка в мм, $svg_fill / $svg_opacity — підсвітка квартири / будинку
$svg_fill = '#ED0057';

// план поверху — мініатюра на сторінці планування (301 x 157px)
