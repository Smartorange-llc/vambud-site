// Друге планування (праворуч від основного, 220px): поле об'єкта з картинкою, напр. 'custom_field_img_1'. '' — не показувати
$by_plan2_field = '';

// у шрифті NeueMachina немає гліфів ² та № — вони виводяться шрифтом montserrat (.by-glyph)
$by_m2 = $this->_e('м', $lang).'<span class="by-glyph">²</span>';

$by_h = function ($text) {
    return htmlspecialchars($text, ENT_QUOTES, 'UTF-8');
};

$by_type_label = mb_strtoupper(mb_substr($type_object, 0, 1, 'UTF-8'), 'UTF-8').mb_substr($type_object, 1, null, 'UTF-8');

$by_params = [];

if (!empty($flat->sec_name)) $by_params[] = [$this->_e('Секція', $lang), $by_h($flat->sec_name)];

$by_params[] = [$this->_e('Поверх', $lang), $flat->floor];
$by_params[] = [$by_type_label.' <span class="by-glyph">№</span>', $flat->number];
$by_params[] = [$this->_e('Загальна площа', $lang), round($flat->all_room, 2).' '.$by_m2];

if ($flat->life_room != 0) $by_params[] = [$this->_e('Житлова площа', $lang), $flat->life_room.' '.$by_m2];

$by_rooms = [];

if (!empty($flat->properties)) {
    foreach ($flat->properties as $room) {
        if ($room->property_name) $by_rooms[] = $room;
    }
}

$by_compact = (count($by_rooms) > 10)? ' by-room-compact' : '';

// Ліва колонка 800px: інформація зверху, контакти притиснуті донизу. Висота інформації в px макета:
// лого 50 + 20 + тип 28 + 20 + параметри по 20 + 18 + приміщення по 20 (16.67 якщо їх більше 10)
$by_px = 297 / 1269;
$by_info_h = round((136 + count($by_params) * 20 + count($by_rooms) * ($by_compact? 16.67 : 20) + 2) * $by_px, 2);
$by_contact_h = max(0, round(187.23 - $by_info_h, 2));

// Сторінка девелопера: лого 50 + 20 + заголовок 56 + 12 + текст 153
$by_about_info_h = round(293 * $by_px, 2);
$by_about_contact_h = round(187.23 - $by_about_info_h, 2);

// Картинка $w x $h, вписана в рамку $boxW x $boxH мм (object-fit: contain)
$by_fit = function ($w, $h, $boxW, $boxH) {
    if ($w <= 0 || $h <= 0) return [$boxW, $boxH];

    $k = min($boxW / $w, $boxH / $h);

    return [round($w * $k, 2), round($h * $k, 2)];
};

$by_img = function ($file, $boxW, $boxH) use ($by_fit) {
    $size = @getimagesize($file);

    if (!$size) return '<img src="'.$file.'" style="max-width: '.$boxW.'mm; max-height: '.$boxH.'mm;" />';

    list($w, $h) = $by_fit($size[0], $size[1], $boxW, $boxH);

    return '<img src="'.$file.'" style="width: '.$w.'mm; height: '.$h.'mm;" />';
};

// Фото фоном комірки $boxW x $boxH мм з обрізкою під рамку (object-fit: cover), $pos — яку частину фото лишити
$by_cover = function ($file, $boxW, $boxH, $pos) {
    $size = @getimagesize($file);
    $resize = 6;

    if ($size && $size[1] > 0) $resize = ($size[0] / $size[1] > $boxW / $boxH)? 5 : 4;

    return 'background-image: url('.$file.'); background-repeat: no-repeat; background-image-resize: '.$resize.'; background-position: '.$pos.';';
};

$by_plan = ($flat->img_big)? $dirs.'/'.$this->cropImg($flat->img_big, 'resize', false, 1500, 0) : '';

$by_plan2 = '';

if ($by_plan2_field && !empty($flat->{$by_plan2_field})) {
    $by_plan2 = "/img/projects/{$flat->project_id}/{$flat->build}/{$flat->{$by_plan2_field}}";
    $by_plan2 = (file_exists($dirs.$by_plan2))? $dirs.$by_plan2 : '';
}

// Кулька за блоком контактів (Figma: 200x200px, x -50px, y 462px) — фон таблиці сторінки.
// Розмір 46.81мм задається через роздільну здатність, тож підійде квадратний sphere.png будь-якого розміру
$by_sphere = $by_assets.'/sphere.png';
