 * Figma: A4 PDF 1 (планування), A4 PDF 2 (план поверху), A4 PDF 3 (девелопер).
 * Верстка лише таблицями: без div у td, без float і position.
 * Фото сторінки девелопера: themes/apica/frontend/views/layouts/pdf/1.jpg, 2.jpg, 3.jpg (як у старому шаблоні),
 * інші картинки макета: themes/apica/frontend/views/layouts/pdf/bubbles-yard/
 */

$type_object = (isset($this->config->api_settings->type_view->{$flat->type_object}))? $this->_e($this->config->api_settings->type_view->{$flat->type_object}->text->{0}) : $this->_e('Квартира');

