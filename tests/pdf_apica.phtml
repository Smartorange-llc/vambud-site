// Картинка з полігонами ($Data як $SvgData: ['img' => [ширина, висота, 'name' => шлях], 'dataList' => [...]])
// у рамці 301 x 157px з обрізкою (object-fit: cover); $is_active($polygon) — які полігони підсвітити.
// Будується тут, а не через genplanSvgBlockSmall.phtml: стара версія того файлу бере $width/$height з шаблону (850px)
// і mPDF стискає всю 2 сторінку
$by_thumb_svg = function ($Data, $is_active) use ($dirs, $svg_fill) {
    if (empty($Data['img']['name']) || !is_file($dirs.$Data['img']['name'])) return '';

    $gw = isset($Data['img'][0])? (float)$Data['img'][0] : 0;
    $gh = isset($Data['img'][1])? (float)$Data['img'][1] : 0;

    if ($gw <= 0 || $gh <= 0) {
        $size = @getimagesize($dirs.$Data['img']['name']);
        $gw = ($size)? $size[0] : 0;
        $gh = ($size)? $size[1] : 0;
    }

    if ($gw <= 0 || $gh <= 0) return '';

    $box_w = 70.45;
    $box_h = 36.74;
    $vw = $gw;
    $vh = $gh;

    if ($vw / $vh > $box_w / $box_h) {
        $vw = $vh * $box_w / $box_h;
    } else {
        $vh = $vw * $box_h / $box_w;
    }

    $svg = '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="'.$box_w.'mm" height="'.$box_h.'mm" viewBox="'.round(($gw - $vw) / 2, 2).' '.round(($gh - $vh) / 2, 2).' '.round($vw, 2).' '.round($vh, 2).'">';
    $svg.= '<image xlink:href="'.$dirs.$Data['img']['name'].'" x="0" y="0" width="'.$gw.'" height="'.$gh.'"></image>';

    if (!empty($Data['dataList'])) {
        foreach ($Data['dataList'] as $polygon) {
            if (!empty($polygon->sorts) && $is_active($polygon)) {
                $svg.= '<polygon style="fill:'.$svg_fill.'; fill-opacity:0.6;" points="'.$polygon->sorts.'"></polygon>';
            }
        }
    }

    return $svg.'</svg>';
};

// Генплан з підсвіченим будинком; якщо генплану немає — рендер з макета
$by_genplan = (isset($SvgData))? $by_thumb_svg($SvgData, function ($polygon) use ($flat) { return $polygon->build == $flat->build; }) : '';

// Обліт будинку з обведеним поверхом — поруч з генпланом на сторінці поверху.
// $FlyData — у тому ж форматі, що $SvgData, поверхи в 'dataList' з ->sorts та ->floor. Якщо обльоту немає — блок не виводиться,
// нотатки займають всю ширину
$by_fly = (isset($FlyData))? $by_thumb_svg($FlyData, function ($polygon) use ($flat) { return isset($polygon->floor) && $polygon->floor == $flat->floor; }) : '';

// Колонки нижнього ряду сторінки поверху: генплан | 20px | обліт | 50px | нотатки
