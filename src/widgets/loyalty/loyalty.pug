mixin loyalty
  section.loyalty.container
    .loyalty__inner
      .loyalty__media
        img.loyalty__image(src="/src/shared/images/home/loyal.jpg" alt="Програма лояльності VAMBUD свої" loading="lazy")
      .loyalty__content
        h2.loyalty__title Програма лояльності
        p.loyalty__text Ваша довіра - найцінніший актив для нас. Саме тому ми створили програму лояльності "VAMBUD свої" - для тих, хто став частиною нашої родини. Ця програма відкриває двері до ексклюзивних знижок від наших партнерів. Приєднуйтесь до "VAMBUD свої" - де кожен клієнт отримує більше, ніж очікує.
        button.loyalty__cta.general-btn(type="button" data-call-us-btn)
          span Отримати картку
