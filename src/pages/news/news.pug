extends /../index.pug

block variable
  -
    var title_page = 'Новини'
    var id_page = 'id-page-news'

block meta
  title= title_page
  meta(name='description', content='Новини та акції компанії VAMBUD: хід будівництва, нові пропозиції, знижки та важливі оновлення.')

block header
  +header()

block content
  -
    // На WP замінити на реальний список новин/акцій (CPT), тут — мокові дані
    // для перевірки фільтрації, пагінації та кнопки "Завантажити ще".
    var newsItems = [
      { title: "Ми у ТОП-20 рейтингу від LUN та Forbes", date: "06.08.2025", image: "/src/shared/images/comp/8.jpg", href: "/single-news.html", type: "news" },
      { title: "Простір, який впливає на здоров'я та емоційний стан вас і вашої дитини", date: "06.08.2025", image: "/src/shared/images/comp/30.jpg", href: "/single-news.html", type: "news" },
      { title: "Елітна нерухомість Прикарпаття", date: "06.08.2025", image: "/src/shared/images/comp/70.jpg", href: "/single-news.html", type: "news" },
      { title: "Знижка -10% на квартири до кінця місяця", date: "02.08.2025", image: "/src/shared/images/comp/45.jpg", href: "/single-news.html", type: "promo" },
      { title: "VAMBUD представив нову концепцію двору", date: "28.07.2025", image: "/src/shared/images/comp/60.jpg", href: "/single-news.html", type: "news" },
      { title: "Стартував продаж квартир у новій черзі", date: "15.07.2025", image: "/src/shared/images/comp/22.jpg", href: "/single-news.html", type: "news" },
      { title: "Архітектурні рішення для комфортного життя", date: "02.07.2025", image: "/src/shared/images/comp/34.jpg", href: "/single-news.html", type: "news" },
      { title: "Акційна пропозиція на квартири в ЖК Долішній", date: "24.06.2025", image: "/src/shared/images/comp/12.jpg", href: "/single-news.html", type: "promo" },
      { title: "Триває оздоблення місць загального користування", date: "18.06.2025", image: "/src/shared/images/comp/50.jpg", href: "/single-news.html", type: "news" },
      { title: "Висаджено нові дерева та зелені зони у дворі комплексу", date: "10.06.2025", image: "/src/shared/images/comp/5.jpg", href: "/single-news.html", type: "news" },
      { title: "Як формувались планування квартир у другій черзі", date: "02.06.2025", image: "/src/shared/images/comp/40.jpg", href: "/single-news.html", type: "news" },
      { title: "Знижка на розтермінування для перших покупців", date: "27.05.2025", image: "/src/shared/images/comp/17.jpg", href: "/single-news.html", type: "promo" },
      { title: "Завершено монтаж фасаду першого будинку", date: "20.05.2025", image: "/src/shared/images/comp/63.jpg", href: "/single-news.html", type: "news" },
      { title: "Нова дитяча ігрова зона вже відкрита", date: "12.05.2025", image: "/src/shared/images/comp/27.jpg", href: "/single-news.html", type: "news" },
      { title: "Спецпропозиція до Дня захисника: -5% на всі квартири", date: "05.05.2025", image: "/src/shared/images/comp/9.jpg", href: "/single-news.html", type: "promo" },
      { title: "Підбито підсумки будівельного сезону", date: "28.04.2025", image: "/src/shared/images/comp/54.jpg", href: "/single-news.html", type: "news" },
      { title: "Відкрито новий відділ продажу у центрі міста", date: "20.04.2025", image: "/src/shared/images/comp/33.jpg", href: "/single-news.html", type: "news" },
      { title: "Стартувала програма лояльності для власників квартир", date: "14.04.2025", image: "/src/shared/images/comp/6.jpg", href: "/single-news.html", type: "promo" },
      { title: "Розпочато будівництво третього будинку", date: "05.04.2025", image: "/src/shared/images/comp/48.jpg", href: "/single-news.html", type: "news" },
      { title: "Оновлено генеральний план розвитку комплексу", date: "29.03.2025", image: "/src/shared/images/comp/21.jpg", href: "/single-news.html", type: "news" }
    ]
    var categories = [
      { id: "all", label: "Усі" },
      { id: "news", label: "Новини" },
      { id: "promo", label: "Акції" }
    ]

  section.news-page-hero
    img.news-page-hero__bg(src="/src/shared/images/news/hero.png" alt="Новини VAMBUD" loading="eager")
    .news-page-hero__overlay
    .news-page-hero__inner.container
      +breadcrumbs([{ label: "Головна", href: "/home.html" }, { label: "Новини" }])
      h1.news-page-hero__title Новини

  section.news-page.container
    .news-page__toolbar(role="tablist" aria-label="Фільтр новин")
      each cat in categories
        - var count = cat.id === "all" ? newsItems.length : newsItems.filter(function (item) { return item.type === cat.id; }).length
        button.news-page__filter-btn(type="button" data-news-filter=cat.id role="tab" aria-selected=cat.id === "all" ? "true" : "false" class=cat.id === "all" ? "is-active" : "")
          span= cat.label
          if cat.id !== "all"
            span.news-page__filter-count= " (" + count + ")"

    .news-page__grid(data-news-grid)
      each item in newsItems
        +newsCard(item)(data-news-card data-news-type=item.type)

    p.news-page__empty(data-news-empty hidden) За цією категорією новин поки немає. Спробуйте інший фільтр.

    +pagination()

    -
      var newsSeoSections = [
        {
          items: [
            { text: "Квартири в новобудовах Івано-Франківськ, купити квартиру у Vambud. Компанія VAMBUD будує сучасні енергонезалежні житлові комплекси в перспективних районах Івано-Франківська з розвиненою інфраструктурою, зручним розташуванням та вигідними умовами придбання. Слідкуйте за новинами будівництва, акціями та спеціальними пропозиціями для покупців квартир — плановими та завершеними чергами наших житлових комплексів." },
            { text: "Ми регулярно публікуємо звіти про хід будівництва: заливку фундаменту, монтаж перекриттів, оздоблення місць загального користування та благоустрій прибудинкової території. Тут також з'являються акційні пропозиції на квартири в готових чергах, знижки для перших покупців, умови розстрочення від забудовника та державних програм на кшталт «єОселя». Підпишіться на новини, щоб не пропустити вигідні умови придбання квартири у новобудовах Івано-Франківська від VAMBUD." }
          ]
        }
      ]
    +seoAccordion("Квартири в новобудовах Івано-Франківська від VAMBUD", newsSeoSections)

  +footer()

block scripts
  script(type="module" src="/src/pages/news/news.js")
