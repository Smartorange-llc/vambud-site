extends /../index.pug

block variable
  -
    var title_page = 'Вакансії'
    var id_page = 'id-page-vacancies'

block meta
  title= title_page
  meta(name='description', content='Вакансії будівельної компанії VAMBUD: керівні, інженерні та робітничі позиції. Приєднуйтесь до команди.')

block header
  +header

block content
