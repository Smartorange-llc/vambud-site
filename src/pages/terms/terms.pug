  mixin benefitSection(item)
    section.terms-benefit(class=`terms-benefit--${item.theme}` id=item.id ? item.id : undefined)
      .container
        .terms-benefit__card
          if item.image
            img.terms-benefit__bg(src=item.image alt="" loading="lazy" data-parallax="image")
            .terms-benefit__overlay
          .terms-benefit__inner
            .terms-benefit__header
              h2.terms-benefit__title= item.title
              .terms-benefit__text
                if item.logo
                  .terms-benefit__lead-row
                    p.terms-benefit__lead= item.lead
                    img.terms-benefit__logo(src="/src/shared/images/terms/eoselya-logo.svg" alt="єОселя" loading="lazy")
                else
                  p.terms-benefit__lead= item.lead
                a.terms-benefit__btn.terms-btn.terms-btn--accent(href="#")
                  span Обрати квартиру
                  +termsArrow()
            .terms-benefit__rows
              each row in item.rows
                .terms-benefit__row
                  span.terms-benefit__row-label= row.label
                  p.terms-benefit__row-text!= row.text

  section.terms-hero
    img.terms-hero__bg(src="/src/shared/images/terms/main-banner.jpg" alt="VAMBUD" loading="eager")
    .terms-hero__overlay
    .terms-hero__inner.container
      +breadcrumbs([{ label: "Головна", href: "/home.html" }, { label: "Умови придбання" }])
      h1.terms-hero__title Умови придбання

  section.terms-pitch.container
    .terms-pitch__card
      img.terms-pitch__bg(src="/src/shared/images/terms/hero-intro.webp" alt="" loading="eager")
      .terms-pitch__gradient
      .terms-pitch__content
        h2.terms-pitch__title Умови придбання квартир у VAMBUD
        .terms-pitch__group
          p.terms-pitch__text Ми у компанії VAMBUD прагнемо, щоб шлях до вашої нової оселі був максимально комфортним та прозорим. Саме тому розробили гнучкі фінансові умови, які дозволяють обрати оптимальний варіант для кожного покупця.
          a.terms-pitch__btn.terms-btn.terms-btn--light(href="#terms-formats")
            span Переглянути варіанти
            +termsArrow()

  -
    var benefitSections = [
      {
        theme: "light",
        title: "100% оплата: Максимальна вигода",
        lead: "Плануєте купити квартиру від забудовника без зайвих переплат? Повна оплата — це ваш спосіб отримати найвигіднішу ціну на ринку нерухомості.",
        rows: [
          { label: "Гарантована знижка:", text: "Купуючи житло за умови 100% оплати, ви отримуєте спеціальну, найнижчу вартість квадратного метра." },
          { label: "Інвестиція в майбутнє:", text: "Захистіть свої заощадження від інфляції та зафіксуйте найкращу ціну на момент підписання договору." },
          { label: "Швидке оформлення:", text: "Мінімум бюрократії — максимум впевненості у власному житлі." }
        ]
      },
      {
        theme: "dark",
        image: "/src/shared/images/terms/benefit-installment.jpg",
        title: "Розтермінування від забудовника: Безпека та фіксація ціни",
        lead: "Хочете розподілити витрати, але не готові переплачувати за банківськими кредитами? Скористайтеся спеціальною програмою розтермінування від будівельної компанії VAMBUD.",
        rows: [
          { label: "Доступний старт:", text: "Для оформлення договору достатньо внести <b>перший внесок від 30%</b> від вартості квартири." },
          { label: "Фіксація ціни:", text: "Вартість квадратного метра залишається незмінною та фіксується на весь термін виплат. Жодних прихованих комісій чи несподіваних подорожчань." },
          { label: "Тривалий термін:", text: "Ми пропонуємо комфортний графік платежів із максимальним терміном виплат <b>до 30 місяців (якщо це старт проєкту).</b>" }
        ]
      },
      {
        theme: "light",
        logo: true,
        title: "Державна програма «єОселя»: Доступне житло під 3% або 7%",
        lead: "VAMBUD підтримує державні ініціативи та пропонує придбання квартир за програмою пільгового іпотечного кредитування «єОселя». Це унікальний шанс стати власником сучасного житла на надзвичайно вигідних умовах.",
        rows: [
          { label: "Пільгові ставки:", text: "Лише 3% річних для пільгових категорій (військовослужбовці, медики, педагоги, науковці) або 7% для інших громадян, які не мають власного житла." },
          { label: "Мінімальний перший внесок:", text: "Усього від 20% від вартості квартири." },
          { label: "Прозорість та надійність:", text: "Повна відповідність усім вимогам державного банку-партнера та юридична чистота угоди." }
        ]
      }
    ]

  each item in benefitSections
    +benefitSection(item)

  section.terms-formats.container#terms-formats
    .terms-formats__card
      .terms-formats__media
        img(src="/src/shared/images/terms/formats-hero-2.jpg" alt="Формати купівлі VAMBUD" loading="lazy")
        .terms-formats__media-gradient
      .terms-formats__content
        .terms-formats__title
          span.terms-formats__title-accent Формати купівлі:
          span.terms-formats__title-sub Обирайте, як вам зручно
        .terms-formats__group
          p.terms-formats__text Ми подбали про те, щоб процес оформлення документів був максимально простим та безпечним, де б ви не знаходилися. Ви можете придбати квартиру у VAMBUD, завітавши у наш центр продажу, або ж повністю дистанційно.
          a.terms-formats__btn.terms-btn.terms-btn--light(href="#terms-classic")
            span Переглянути формати купівлі
            +termsArrow()

