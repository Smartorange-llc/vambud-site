  //- На WP ця сторінка — лендинг категорії "1-кімнатні" (спільний для всіх
  //- ЖК VAMBUD, а не окремого проєкту). 2-кімнатні/3-кімнатні матимуть
  //- аналогічні сторінки за тією ж схемою — /two-room.html, /three-room.html.
  section.one-room-hero
    img.one-room-hero__bg(src="/src/shared/images/one-main.jpg" alt="Однокімнатні квартири VAMBUD" loading="eager")
    .one-room-hero__overlay
    .one-room-hero__inner.container
      +breadcrumbs([{ label: "VAMBUD", href: "/home.html" }, { label: "1-кімнатні" }])
      h1.one-room-hero__title 1-кімнатні
      p.one-room-hero__subtitle 1-кімнатні квартири в Івано-Франківську

  section#one-room-projects.one-room-projects.container
    -
      var krakivskyiProject = { title: "Квартал Краківський", badge: "Енергонезалежні квартири", price: "від 42 200 грн/м²", location: "м. Івано-Франківськ, р-н Позитрон (поруч ТРЦ Veles Mall)", image: "/src/shared/images/comp/20.jpg" }
      var wawelProject = { title: "WAWEL (ВАВЕЛЬ)", badge: "Енергонезалежні квартири", price: "від 44 400 грн/м²", location: "м. Івано-Франківськ, р-н Позитрон (поруч ТРЦ Veles Mall)", image: "/src/shared/images/comp/50.jpg" }
      var dolishniyProject = { title: "Долішній", badge: "Енергонезалежні квартири", price: "від 45 700 грн/м²", location: "м. Івано-Франківськ, р-н міського озера", image: "/src/shared/images/comp/5.jpg" }
      var prostirProject = { title: "PROSTIR (ПРОСТІР)", badge: "Енергонезалежні квартири", price: "від 45 300 грн/м²", location: "м. Івано-Франківськ, вул. Петлюри-Польова", image: "/src/shared/images/comp/35.jpg" }
      var oneRoomProjects = [
        Object.assign({ href: "#", status: "sale", tags: ["known"] }, wawelProject),
        Object.assign({ href: "#", status: "sale", tags: ["known", "eoselya"] }, prostirProject),
        Object.assign({ href: "#", status: "building", tags: [] }, krakivskyiProject),
        Object.assign({ href: "#", status: "building", tags: ["eoselya"] }, dolishniyProject),
        Object.assign({ href: "#", status: "sale", tags: ["eoselya"] }, wawelProject),
        Object.assign({ href: "#", status: "building", tags: ["known"] }, prostirProject),
        Object.assign({ href: "#", status: "sale", tags: [] }, krakivskyiProject),
        Object.assign({ href: "#", status: "building", tags: ["known", "eoselya"] }, dolishniyProject),
        Object.assign({ href: "#", status: "sale", tags: ["known"] }, prostirProject)
      ]
      var oneRoomFilters = [
        { id: "sale", label: "В продажі", active: true },
        { id: "building", label: "Будуються" },
        { id: "known", label: "Відомі" },
        { id: "eoselya", label: "Є оселя" },
        { id: "all", label: "Усі" }
      ]
    .one-room-projects__toolbar
      .one-room-projects__filters(role="tablist" aria-label="Фільтр проєктів")
        each filter in oneRoomFilters
          - var filterCount = filter.id === "all" ? oneRoomProjects.length : oneRoomProjects.filter(function (item) { return filter.id === "sale" || filter.id === "building" ? item.status === filter.id : item.tags.indexOf(filter.id) !== -1; }).length
          button.one-room-projects__filter-btn(type="button" data-project-filter=filter.id role="tab" aria-selected=filter.active ? "true" : "false" class=filter.active ? "is-active" : "")
            span= filter.label
            span.one-room-projects__filter-count= " (" + filterCount + ")"

    .one-room-projects__grid(data-projects-grid)
      each project in oneRoomProjects
        a.one-room-projects__card(href=project.href data-project-card data-project-status=project.status data-project-tags=project.tags.join(","))
          img.one-room-projects__image(src=project.image alt=project.title loading="lazy")
          .one-room-projects__top
            span.one-room-projects__price= project.price
            span.one-room-projects__badge= project.badge
          .one-room-projects__info
            .one-room-projects__text
              h3.one-room-projects__name= project.title
              p.one-room-projects__location
                +pinIcon()
                span= project.location
            span.one-room-projects__arrow
              +arrowIcon()

    p.one-room-projects__empty(data-projects-empty hidden) За цим фільтром проєктів поки немає. Спробуйте інший фільтр.

  section.one-room-card.container
    .one-room-card__inner
      .one-room-card__media.one-room-card__media--plan
        img(src="/src/shared/images/single-project/floorplan-1.png" alt="Планування 1-кімнатної квартири VAMBUD" loading="lazy")
      .one-room-card__text
        h2 1-кімнатні квартири
        p.one-room-card__lead Площі приміщень від 36 м²
        p VAMBUD – ваш надійний партнер у виборі ідеального житла в Івано-Франківську. Ми пропонуємо широкий вибір однокімнатних квартир, які відповідають найвищим стандартам якості та комфорту. Наша компанія має багаторічний досвід на ринку нерухомості, що гарантує надійність та стабільність вашої інвестиції. З VAMBUD ви отримуєте не просто квартиру, а сучасний простір для життя, створений з урахуванням потреб сучасної людини.
        a.one-room-card__cta.general-btn(href="#footer")
          span Завантажити каталог нерухомості
          +arrowIcon()

  section.one-room-intro
    .one-room-intro__watermark VAMBUD
    .one-room-intro__inner.container
      .one-room-intro__text
        h2.one-room-intro__title Різноманітність вибору
        p.one-room-intro__body У нас є квартири на будь-який смак. Ви можете обрати житло в готовому будинку. Або придбати квартиру на етапі будівництва за вигіднішою ціною. Площа наших однокімнатних квартир варіюється від компактних до просторих варіантів. Ми пропонуємо різні класи житла: від економ до еліт-класу. Наші архітектори розробили різноманітні планування, щоб задовольнити потреби різних типів домогосподарств: від самотніх людей до молодих сімей з дітьми.
        a.one-room-intro__cta(href="#one-room-projects")
          span Обрати квартиру
          +arrowIcon()

      .one-room-intro__table
        h3.one-room-intro__table-title 1-кімнатні квартири
        .one-room-intro__table-headers
          span.one-room-intro__col-project Проект
          span.one-room-intro__col-area Площа
          span.one-room-intro__col-price Ціна
        hr.one-room-intro__divider
        -
          var oneRoomRows = [
            { project: "Квартал Краківський", area: "—", price: "Продано", sold: true },
            { project: "WAWEL", area: "43-50 м²", price: "46800-52000 ₴/м²" },
            { project: "Долішній", area: "—", price: "Продано", sold: true },
            { project: "TRIVIUM", area: "37-45 м²", price: "77800-87400 ₴/м²" },
            { project: "Prostir", area: "39 м²", price: "46800 ₴/м²" },
            { project: "Shepit", area: "32-58 м²", price: "43300-44200 ₴/м²" }
          ]
        each row, index in oneRoomRows
          .one-room-intro__table-row
            span.one-room-intro__col-project= row.project
            span.one-room-intro__col-area= row.area
            span.one-room-intro__col-price(class=row.sold ? "is-muted" : "")= row.price
          if index !== oneRoomRows.length - 1
            hr.one-room-intro__divider

  section.one-room-benefits.container
    .one-room-benefits__inner
      .one-room-benefits__text
        h2.one-room-benefits__title Переваги нашого житла
        p.one-room-benefits__body Наші однокімнатні квартири — це втілення комфорту та функціональності. Кожен проєкт створений з думкою про мешканців, використовуючи енергоефективні технології.
        p.one-room-benefits__body Якість будівництва — наш пріоритет. Ми використовуємо лише перевірені матеріали.
        p.one-room-benefits__body Розташування наших комплексів завжди вдале — територія завжди доглянута, а ми активно розвиваємо інфраструктуру районів.
        a.one-room-benefits__cta.general-btn(href="#footer")
          span Завантажити каталог нерухомості
          +arrowIcon()

      .one-room-benefits__grid
        - var benefits = [ { icon: "playground", title: "Безпечні дитячі майданчики" }, { icon: "heating", title: "Індивідуальне газове опалення" }, { icon: "infra", title: "Розвинена інфраструктура" }, { icon: "comfort", title: "Комфортне середовище" }, { icon: "materials", title: "Якісні матеріали" }, { icon: "layout", title: "Продумане планування" }, { icon: "territory", title: "Доглянута територія" }, { icon: "parking", title: "Зручні паркінги" }, { icon: "energy", title: "Енергоефективні технології" }, { icon: "location", title: "Вдале розташування" } ]
        each item in benefits
          .one-room-benefits__card
            .one-room-benefits__icon
              case item.icon
                when "playground"
                  +playgroundIcon()
                when "heating"
                  +heatingIcon()
                when "infra"
                  +infraIcon()
                when "comfort"
                  +comfortIcon()
                when "materials"
                  +materialsIcon()
                when "layout"
                  +layoutIcon()
                when "territory"
                  +territoryIcon()
                when "parking"
                  +parkingIcon()
                when "energy"
                  +energyIcon()
                when "location"
                  +locationIcon()
            p.one-room-benefits__card-title= item.title

  section.one-room-card.container
    .one-room-card__inner
      img.one-room-card__media(src="/src/shared/images/one-room.jpg" alt="Інвестиційна привабливість квартир VAMBUD" loading="lazy")
      .one-room-card__text
        h2 Інвестиційна привабливість
        p.one-room-card__lead Наші квартири — це надійна інвестиція.
        p Ціни на нерухомість у Івано-Франківську стабільно зростають. Купуючи зараз, ви забезпечуєте своє майбутнє. Однокімнатні квартири завжди користуються попитом серед орендарів. Це гарантує стабільний пасивний дохід. Вартість наших квартир починається від доступних 30 260 $. При цьому якість будівництва відповідає європейським стандартам, що робить наші пропозиції особливо привабливими для тих, хто шукає оптимальне співвідношення ціни та якості на ринку нерухомості Івано-Франківська.
        a.one-room-card__cta.general-btn(href="#footer")
          span Обрати квартиру
          +arrowIcon()

  section.one-room-planning.container
    h2.one-room-planning__title Пропонуємо ознайомитись з нашими пропозиціями
    .one-room-planning__slider.swiper
      //- .one-room-planning__nav-arrows
      //-   button.one-room-planning__arrow.one-room-planning__arrow--prev(type="button" data-planning-prev aria-label="Попередня пропозиція")
      //-     +navArrowIcon()
      //-   button.one-room-planning__arrow.one-room-planning__arrow--next(type="button" data-planning-next aria-label="Наступна пропозиція")
      //-     +navArrowIcon()
      .swiper-wrapper
        -
          var crossSell = [
            {
              title: "2-кімнатні квартири",
              area: "49-93 м²",
              href: "/two-room.html",
              points: [
                "Підходить молодим сім'ям.",
                "Зручне планування з окремими кімнатами, просторою кухнею та санвузлом. Встановлено індивідуальне опалення",
                "Розташування в зручних районах міста з доступом до громадського транспорту, шкіл та дитячих садків."
              ]
            },
            {
              title: "3-кімнатні квартири",
              area: "61-113 м²",
              href: "/three-room.html",
              points: [
                "Ідеальний вибір для великих родин.",
                "Квартири оснащені сучасними інженерними системами.",
                "Розташування в престижних районах міста з розвиненою інфраструктурою та зручним транспортним сполученням."
              ]
            }
          ]
        each item in crossSell
          .swiper-slide.one-room-planning__card
            h3.one-room-planning__card-title= item.title
            .one-room-planning__content
              .one-room-planning__flat
                img(src="/src/shared/images/single-project/floorplan-1.png" alt=item.title loading="lazy")
              .one-room-planning__specs
                span.one-room-planning__area= item.area
                ul.one-room-planning__points
                  each point in item.points
                    li= point
                a.one-room-planning__cta.general-btn(href=item.href)
                  span Дізнатися більше
                  +arrowIcon()

