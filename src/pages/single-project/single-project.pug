          .single-project-documents__body(data-doc-body)
            if doc.tabs
              .single-project-documents__tabs(role="tablist" data-doc-tabs)
                each tab, tabIndex in doc.tabs
                  button.single-project-documents__tab(type="button" role="tab" class=tabIndex === 0 ? "is-active" : "" aria-selected=tabIndex === 0 ? "true" : "false" data-doc-tab=tabIndex)= tab.label
              if doc.warning
                .single-project-documents__warning
                  +warningIcon()
                  p= doc.warning
              each tab, tabIndex in doc.tabs
                .single-project-documents__doc(data-doc-tab-panel=tabIndex class=tabIndex === 0 ? "" : "hidden")
