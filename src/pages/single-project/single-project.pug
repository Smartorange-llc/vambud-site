                span(data-calc-down-min) 0 $
                span(data-calc-down-max) 0 $

            .single-project-calculator__field.single-project-calculator__field--slider
              .single-project-calculator__field-text
                span.single-project-calculator__label Термін (від 2 до 20 років)
                span.single-project-calculator__value(data-calc-term-value) 19
              input.single-project-calculator__range(type="range" min="2" max="20" step="1" value="19" data-calc-term aria-label="Термін розтермінування")
