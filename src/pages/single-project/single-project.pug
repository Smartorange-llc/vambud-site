    h2.single-project-documents__title Документи
    .single-project-documents__list
      -
        var documents = [
          {
            title: "Документи на земельну ділянку",
            warning: "Зверніть увагу, в цілях безпеки, з 24.02.2022 всі посилання на Кадастрову карту України не працюють, сервіс недоступний для перегляду.",
            tabs: [
              { label: "Земельна ділянка", cadastre: "2610190501:09:003:0127", purpose: "(02.07 Для іншої житлової забудови)" },
              { label: "Кадастровий номер земельної ділянки", cadastre: "2610190501:09:003:0114", purpose: "(03.15 Для будівництва та обслуговування інших будівель громадської забудови для комплексної забудови території з об'єктами соціальної сфери та житлового будівництва)" }
            ]
          },
          {
            title: "Дозвільна документація",
            items: [
              { cadastre: "Дозвіл на виконання будівельних робіт", purpose: "№ ІФ 115251920123 від 12.05.2022" }
            ]
          },
          {
            title: "Проєктна документація",
            items: [
              { cadastre: "Експертний звіт щодо проєктної документації", purpose: "затверджено ДП «Івано-Франківськдержбудекспертиза»" }
            ]
          }
        ]
      each doc, index in documents
        .single-project-documents__item(data-doc-item class=index === 0 ? "is-open" : "")
          button.single-project-documents__head(type="button" data-doc-trigger aria-expanded=index === 0 ? "true" : "false")
            span.single-project-documents__head-title= doc.title
