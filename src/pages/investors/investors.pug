  section.inv-resale.container
    .inv-resale__card
      span.inv-resale__wordmark VAMBUD
      .inv-resale__intro
        h2.inv-resale__title VAMBUD перепродаж
        .inv-resale__desc
          p.inv-resale__lead VAMBUD перепродаж — гарантований спосіб максимізувати дохід від нерухомості без зайвих клопотів
          p.inv-resale__text Для наших клієнтів працює ексклюзивний внутрішній сервіс, який повністю розв'язує питання реалізації ваших активів. Вам більше не потрібно самостійно шукати покупців, рекламувати об'єкт та витрачати час на покази. Професійна команда VAMBUD бере на себе весь цикл перепродажу нерухомості:
        a.general-btn(href="/resale.html")
          span Детальніше про сервіс
          +invArrow()
      .inv-resale__grid
        -
          var features = [
            { title: "Експертна оцінка", desc: "Експертна оцінка поточної ринкової вартості вашої квартири чи комерційної площі" },
            { title: "Маркетинг", desc: "Запуск потужної маркетингової компанії та залучення покупців через внутрішню базу девелопера" },
            { title: "Переговори", desc: "Повний супровід переговорів, показів об'єкта та підготовки документів" },
            { title: "Юридична безпека", desc: "Абсолютна юридична безпека та чистота проведення угоди купівлі-продажу" }
          ]
        each feature, index in features
          .inv-resale__feature
            span.inv-resale__num= (index + 1) < 10 ? '0' + (index + 1) : (index + 1)
            h3.inv-resale__feature-title= feature.title
            p.inv-resale__feature-desc= feature.desc

