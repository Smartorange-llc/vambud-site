extends /../index.pug

block variable
  -
    var title_page = 'Для інвесторів'
    var id_page = 'id-page-investors'

block meta
  title= title_page
  meta(name='description', content='Надійні інвестиції в нерухомість від VAMBUD: стратегії інвестування, переваги співпраці, сервіс перепродажу та актуальні пропозиції з дохідністю.')

block header
  +header

block content
  mixin invArrow()
    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none")
      path(d="M12.771 12.7715L12.771 13.7715L10.771 13.7715L10.771 7.64355L4.229 14.1855L2.81494 12.7715L9.35693 6.22949L3.229 6.22949L3.229 4.22949L4.229 4.22949L11.772 4.22852C12.037 4.2286 12.2916 4.3341 12.479 4.52148C12.6664 4.70892 12.7719 4.96349 12.772 5.22852L12.771 12.7715Z" fill="white")

  mixin invPin()
    svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none").inv-pin
      path(d="M13.6665 5.39844C13.6664 8.37953 8.3335 16 8.3335 16C8.31026 15.9668 3.00057 8.373 3.00049 5.39844C3.00049 2.41669 5.38809 0.00012786 8.3335 2.33113e-07C11.279 2.33113e-07 13.6665 2.41661 13.6665 5.39844ZM10.7876 5.39844C10.7876 4.02561 9.68881 2.91406 8.3335 2.91406C6.97732 2.91419 5.87939 4.02569 5.87939 5.39844C5.87954 6.77106 6.9776 7.88171 8.3335 7.88184C9.68873 7.88184 10.7875 6.77114 10.7876 5.39844Z" fill="#4A5866")

  section.inv-banner
    img.inv-banner__bg(src="/src/shared/images/investors/main-banner.jpg" alt="VAMBUD" loading="eager")
    .inv-banner__overlay
    .inv-banner__inner.container
      +breadcrumbs([{ label: "VAMBUD", href: "/home.html" }, { label: "Для інвесторів" }])
      h1.inv-banner__title Для інвесторів

  section.inv-start.container
    .inv-start__hero
      .inv-start__hero-text
        h2.inv-start__hero-title Надійні інвестиції в нерухомість від VAMBUD
        p.inv-start__hero-lead Отримуйте пасивний дохід або капіталізуйте кошти із девелопером, який входить у ТОП-10 України.
        button.general-btn(type="button" data-call-us-btn)
          span Отримати консультацію
          +invArrow()
      .inv-start__hero-media
        img(src="/src/shared/images/investors/hero.jpg" alt="Інвестиції в нерухомість VAMBUD" loading="eager" data-parallax="image")
        .inv-start__hero-gradient

    ul.inv-stats
      -
        var stats = [
          { value: "до 30 місяців", label: "Розтермінування платежів", note: "З одночасним зростанням ліквідності об'єкту" },
          { value: "до 140%", label: "Зростання вартості", note: "Від котловану до здачі будинку" },
          { value: "ТОП-10", label: "Рейтинг девелоперів", note: "України за версією Ukrainian Business Award" }
        ]
      each stat in stats
        li.inv-stats__item
          .inv-stats__top
            span.inv-stats__value= stat.value
            span.inv-stats__label= stat.label
          .inv-stats__divider
            span.inv-stats__divider-dot
          p.inv-stats__note= stat.note

  section.inv-types.container
    .inv-types__card
      .inv-types__head
        h2.inv-types__title Стратегії інвестування
        p.inv-types__subtitle Оберіть вашу стратегію інвестування
      .inv-types__grid
        -
          var types = [
            { title: "Житлова нерухомість", desc: "Smart- та 1-кімнатні квартири з найвищим рівнем ліквідності для швидкого перепродажу або здачі в довгострокову оренду.", image: "card-residential.jpg" },
            { title: "Комерційна нерухомість", desc: "Просторі площі під street-ритейл у густонаселених житлових комплексах із прогнозовано високим окупним потенціалом.", image: "card-commercial.jpg" },
            { title: "Комори та паркомісця", desc: "Низький поріг входу в інвестицію, мінімальні капіталовкладення та стабільний попит серед тисяч мешканців наших житлових комплексів.", image: "card-storage.jpg" },
            { title: "Ультра-преміум сегмент", desc: "Лімітована колекційна нерухомість для примноження капіталу у топовій локації міста, яка стабільно дорожчає.", image: "card-premium.jpg" }
          ]
        each type in types
          .inv-types__item
            img.inv-types__image(src="/src/shared/images/investors/" + type.image alt=type.title loading="lazy")
            .inv-types__text
              h3.inv-types__item-title= type.title
              p.inv-types__item-desc= type.desc
            button.general-btn(type="button" data-call-us-btn)
              span Отримати каталог
              +invArrow()

  section.inv-benefits.container
    .inv-benefits__card
      .inv-benefits__head
        h2.inv-benefits__title Чому інвестори обирають VAMBUD?
        p.inv-benefits__subtitle Інвестувати в квадратні метри — безпечно, якщо ваш партнер надійний та має у пропозиції унікальні проєкти на ринку.
