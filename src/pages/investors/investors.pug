    .inv-projects__card
      .inv-projects__head
        h2.inv-projects__title Пропозиції з дохідністю
        p.inv-projects__subtitle Актуальні об'єкти для інвестицій
        p.inv-projects__lead Проєкти з найвищим прогнозованим індексом дохідності та унікальними ринковими характеристиками
      .inv-projects__row
        -
          var projects = [
            {
              name: "TRIVIUM (ТРІВІУМ)",
              price: "від 45 300 грн/м²",
              location: "м. Івано-Франківськ, вул. Петлюри-Польова",
              image: "project-trivium.jpg",
              tags: ["Квартири з терасами і патіо", "Навпроти парку Шевченка та озера", "Ексклюзивні видові квартири", "Прогнозований приріст: від 20% на рік"]
            },
            {
              name: "PROSTIR (ПРОСТІР)",
              price: "від 45 300 грн/м²",
              location: "м. Івано-Франківськ, вул. Петлюри-Польова",
              image: "project-prostir.jpg",
              tags: ["Квартири з терасами і патіо", "Довгоочікуваний старт продажу 2 черги проєкту", "Найнижча вхідна вартість квадратного метра на етапі котловану", "Найдовше розтермінування до 4 кварталу 2028 року"]
            }
          ]
        each project in projects
          .inv-projects__item
            .inv-projects__image-wrap
              img.inv-projects__image(src="/src/shared/images/investors/" + project.image alt=project.name loading="lazy")
              span.inv-projects__price= project.price
              ul.inv-projects__tags
