extends /../index.pug

block variable
  - var title_page = 'Головна сторінка'

block meta
  title= title_page
  meta(name='description' content='Опис головної сторінки для SEO')

block scripts
  script(type="module", src='/src/pages/home/home.js')

block header
  +header

block content
  section.hero
    .hero__media
      video.hero__video(muted, loop, playsinline, preload="metadata", data-hero-video)
        source(src="/src/shared/images/hero.mp4", type="video/mp4")
        | Ваш браузер не підтримує відео
      .hero__gradient
    .hero__inner.container
      p.hero__label Створюємо власні формати житла
      h1.hero__title Квартири <br class="tab-br"> в <br class="mob-br"> Івано-Франківську
      a.hero__cta.general-btn(href="#" data-presentation-trigger)
        span Завантажити каталог нерухомості
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6.64941 9.89844L2.56641 5.81543L0.798828 7.58301L1.68262 8.4668L7.01562 13.8008C7.24998 14.0351 7.56802 14.1669 7.89941 14.167C8.23082 14.167 8.54881 14.0351 8.7832 13.8008L14.1162 8.4668L15 7.58301L13.2324 5.81543L9.14941 9.89844V1H6.64941V9.89844Z" fill="white"/>
        </svg>
    button.btn-down(type="button" data-hero-scroll aria-label="Прогорнути до наступної секції")
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M7.79492 14.2734L12.1855 9.88281L11.4785 9.17578L8.29492 12.3594L8.29492 2L7.29492 2L7.29492 12.3594L4.11133 9.17578L3.40332 9.88281L7.79492 14.2734Z" fill="white"/>
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M7.79492 14.2734L12.1855 9.88281L11.4785 9.17578L8.29492 12.3594L8.29492 2L7.29492 2L7.29492 12.3594L4.11133 9.17578L3.40332 9.88281L7.79492 14.2734Z" fill="white"/>
      </svg>
 
  section.stats
    .stats__media(data-parallax="image")
      
      img.stats__image.stats__image--bottom(src="/src/shared/images/home/home-about.webp" alt="ЖК Vambud")
      .stats__gradient
    .stats__inner.container
      ul.stats__numbers
        li.stats__item(data-counter-item)
          span.stats__number
            span.stats__number-value(data-counter-target="20") 0
          span.stats__divider
          span.stats__label Років на ринку нерухомості
        li.stats__item(data-counter-item)
          span.stats__number
            span.stats__number-value(data-counter-target="21") 0
          span.stats__divider
          span.stats__label Проєкт нерухомості
        li.stats__item(data-counter-item)
          span.stats__number
            span.stats__number-value(data-counter-target="3000") 0
            | +
          span.stats__divider
          span.stats__label Зданих квартир і щасливих сімей
      .stats__card(data-parallax="card")
        h3.stats__card-title Філософія будівельної компанії
        p.stats__card-text Створюємо простори нового зразка у малоповерхових житлових кварталах, де в центрі уваги завжди є людина та естетика її щоденного середовища. Через власні проєкти ми формуємо нові міські сценарії життя та закладаємо в Івано-Франківську архітектурну спадщину з глибокими сенсами.
        a.stats__card-btn(href="#")
          span Про компанію

  +founder
  +awards
  +projects(["known", "sale", "all"])

  section.commercial
    .commercial__media
      img.commercial__image(src="/src/shared/images/home/commercial.jpg" alt="Комерційна нерухомість VAMBUD" data-parallax="image")
      .commercial__gradient-top
      .commercial__gradient
    .commercial__inner.container
      h2.commercial__title
        span.commercial__word.commercial__word--start(data-parallax-word="start") Комерційна
        span.commercial__word.commercial__word--end(data-parallax-word="end") нерухомість
      a.commercial__cta.stats__card-btn(href="/commercial.html")
        span Дізнатися більше

  +loyalty
  +newsSlider
  +presentationModal

block footer
  +footer  