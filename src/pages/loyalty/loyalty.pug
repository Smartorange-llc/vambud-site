extends /../index.pug

block variable
  -
    var title_page = 'Програма лояльності'
    var id_page = 'id-page-loyalty'

block meta
  title= title_page
  meta(name='description', content='Програма лояльності "VAMBUD свої": ексклюзивні знижки від партнерів для власників нерухомості VAMBUD.')

block header
