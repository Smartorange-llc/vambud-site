        { id: "remont", label: "Ремонт" },
        { id: "health", label: "Здоров'я та краса" }
      ]
    .loyalty-partners__head
      h2.loyalty-partners__title Партнери
      .loyalty-partners__tabs
        each cat in categories
          -
            var count = cat.id === "all" ? partners.length : partners.filter(function (p) { return p.category === cat.id; }).length
          button.loyalty-partners__tab(type="button" class=cat.id === "all" ? "is-active" : "" data-partners-tab=cat.id)
            span= cat.label
            if cat.id !== "all"
              span.loyalty-partners__tab-count= ` (${count})`
    .loyalty-partners__grid
      each partner in partners
        .loyalty-partners__card(
          data-partner-card
          data-partners-item=partner.category
          data-partner-name=partner.name
          data-partner-logo=`/src/shared/images/loyalty/logos/${partner.logo}`
          data-partner-description=partner.description
          data-partner-discounts=JSON.stringify(partner.discounts)
          data-partner-addresses=JSON.stringify(partner.addresses)
          data-partner-phone=partner.phone
        )
          span.loyalty-partners__discount= partner.discount
          .loyalty-partners__logo
            img(src=`/src/shared/images/loyalty/logos/${partner.logo}` alt=partner.name loading="lazy")
